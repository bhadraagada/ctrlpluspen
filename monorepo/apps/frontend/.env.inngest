# Inngest Configuration for Local Development
# Add these to your .env file

# Tell Inngest SDK to use dev server (automatically detects localhost:8288)
INNGEST_DEV=1

# Optional: Explicitly set the dev server URL
# INNGEST_BASE_URL=http://localhost:8288

# Optional: Dummy keys for local development (dev server doesn't validate)
# INNGEST_EVENT_KEY=local_dev_key
# INNGEST_SIGNING_KEY=local_signing_key
